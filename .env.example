# Run from the repository root. Copy to .env, edit, then source explicitly:
# set -a; source .env; set +a
# Keep real credentials only in your ignored .env or external secret store.

FOCUSVTC_DATA_ROOT="${PWD}/datasets"
FOCUSVTC_OUTPUT_ROOT="${PWD}/outputs"
FOCUSVTC_MODEL="${PWD}/models/FocusVTC"
FOCUSVTC_FONT_PATH="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
# Optional evaluation overrides for unsupported CJK glyphs or monospace code.
# FOCUSVTC_CJK_FONT_PATH="/path/to/cjk-font.ttf"
# FOCUSVTC_MONO_FONT_PATH="/path/to/monospace-font.ttf"

# Optional: authentication for font-acuity evaluation endpoints.
FOCUSVTC_API_KEY=""

# REL-SFT: model is set with FOCUSVTC_MODEL above.
FOCUSVTC_SFT_DATASET="${PWD}/datasets/REL-CoT_SFT/train.jsonl"
FOCUSVTC_SFT_ASSETS="${PWD}/datasets/REL-CoT_SFT"
FOCUSVTC_SFT_OUTPUT="${PWD}/outputs/sft"

# GRPO: merged SFT checkpoint and locally prepared Parquet files.
VTC_GRPO_MODEL="${PWD}/models/focusvtc-sft"
VTC_GRPO_TRAIN="${PWD}/datasets/grpo/train.parquet"
VTC_GRPO_VAL="${PWD}/datasets/grpo/val.parquet"
VTC_GRPO_OUTPUT="${PWD}/outputs/grpo"

# Optional separate executables for gateway and vLLM serving.
# CONFIG_PYTHON="/path/to/gateway-env/bin/python"
# BACKEND_PYTHON="/path/to/vllm-env/bin/python"

WANDB_MODE="disabled"
